# ================================================================
# CareSync PH - Online Clinic & Doctor Appointment Booking System
# Environment Configuration
# ================================================================

# System Settings
PROJECT_NAME="CareSync PH"
SECRET_KEY="caresync-super-secret-jwt-session-key-change-in-production"
ENVIRONMENT="development"
APP_URL="http://127.0.0.1:8000"

# Database Configuration (SQLite default; PostgreSQL ready for Render/Railway)
# For SQLite: sqlite:///./clinic.db
# For Postgres: postgresql://user:password@localhost:5432/caresync_db
DATABASE_URL="sqlite:///./clinic.db"

# ----------------------------------------------------------------
# EXTERNAL API 1: PayMongo Payment Gateway (Sandbox / Live)
# Register at: https://paymongo.com or use Sandbox keys
# Test cards & GCash instructions: https://developers.paymongo.com
# ----------------------------------------------------------------
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_BASE_URL="https://api.paymongo.com/v1"

# ----------------------------------------------------------------
# EXTERNAL API 2: Semaphore SMS Gateway
# Register at: https://semaphore.co
# Note: Leaves blank to use smart sandbox simulation
# ----------------------------------------------------------------
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="CareSync"

# ----------------------------------------------------------------
# EXTERNAL API 3: Google Calendar API
# Console: https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------------
GOOGLE_CALENDAR_API_KEY=""

# ----------------------------------------------------------------
# EXTERNAL API 4: Google OAuth 2.0 (Social Sign-in)
# Console: https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------------------
# EXTERNAL API 5: Cloudinary (Medical Document & ID Storage)
# Dashboard: https://cloudinary.com/console
# ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
